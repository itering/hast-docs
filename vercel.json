{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/docs-search/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ],
  "redirects": [
    { "source": "/", "destination": "/en/docs/overview", "permanent": false },
    { "source": "/docs", "destination": "/en/docs/overview", "permanent": false },
    { "source": "/:locale(en|ja|zh-CN)", "destination": "/:locale/docs/overview", "permanent": false },
    { "source": "/:locale(en|ja|zh-CN)/docs", "destination": "/:locale/docs/overview", "permanent": false },
    { "source": "/:locale(en|ja|zh-CN)/docs/task-api-quickstart", "destination": "/:locale/docs/aip-api-quickstart", "permanent": true },
    { "source": "/:locale(en|ja|zh-CN)/docs/task-api-events", "destination": "/:locale/docs/aip-api-events", "permanent": true },
    { "source": "/:locale(en|ja|zh-CN)/docs/task-api-reference", "destination": "/:locale/docs/aip-api-reference", "permanent": true },
    { "source": "/:locale(en|ja|zh-CN)/docs/task-api-auth", "destination": "/:locale/docs/aip-api-reference#authentication", "permanent": true },
    { "source": "/:locale(en|ja|zh-CN)/docs/task-api-sessions", "destination": "/:locale/docs/aip-api-reference#sessions", "permanent": true },
    { "source": "/:locale(en|ja|zh-CN)/docs/task-api-files", "destination": "/:locale/docs/aip-api-reference#files", "permanent": true },
    { "source": "/:locale(en|ja|zh-CN)/docs/task-api-tools", "destination": "/:locale/docs/aip-api-reference#prompts", "permanent": true },
    { "source": "/:locale(en|ja|zh-CN)/docs/task-api-resources", "destination": "/:locale/docs/aip-api-reference", "permanent": true },
    { "source": "/:locale(en|ja|zh-CN)/docs/task-api-errors", "destination": "/:locale/docs/aip-api-reference", "permanent": true }
  ]
}
